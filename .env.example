# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File .env TIDAK boleh ikut di-commit ke git (sudah ada di .gitignore).

DJANGO_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=iot_platform
DB_USER=iot_user
DB_PASSWORD=ganti_password
DB_HOST=127.0.0.1
DB_PORT=3306

# MQTT broker. Bawaan: broker publik EMQX (tanpa login, bisa dibaca siapa saja).
# Ganti nilai-nilai ini untuk memakai broker lain, mis. Mosquitto di server sendiri.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=False
# Awal semua topik; di broker publik buat UNIK, mis. filkom-iot-7f3a9c
MQTT_TOPIC_PREFIX=ganti-dengan-prefix-unik
MQTT_CLIENT_ID=
MQTT_KEEPALIVE=60
# Alamat broker yang ditulis di halaman device untuk dipakai DEVICE.
# Kosong = sama dengan MQTT_HOST/MQTT_PORT/MQTT_TLS di atas. Diisi di server produksi.
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_PORT=
MQTT_PUBLIC_TLS=
MQTT_DEVICE_LOGIN=False
# MQTT over WebSocket untuk browser (tahap 21), mis. wss://iot.domain-anda/mqtt.
# Kosong = tidak ditampilkan. Di laptop biasanya dikosongkan.
MQTT_PUBLIC_WS_URL=
# Akun MQTT sandbox per pengguna (tahap 23). Kosong = ikut MQTT_DEVICE_LOGIN.
MQTT_SANDBOX_ENABLED=

# WebSocket lintas proses (Django Channels + Redis). Kosongkan bila belum ada Redis:
# dashboard tetap real-time untuk data HTTP, dan data MQTT tampil paling lambat 30 detik.
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0

# CoAP (UDP). Device harus bisa menjangkau komputer ini secara langsung.
# COAP_BIND kosong = otomatis (127.0.0.1 + IP Wi-Fi di macOS; semua alamat di Linux)
COAP_BIND=
COAP_PORT=5683
# Alamat yang dipakai device, mis. IP komputer ini di Wi-Fi: 192.168.1.10
COAP_PUBLIC_HOST=
COAP_OBSERVE_INTERVAL=1

# Rule engine (tahap 7). Kosong = otomatis: "worker" bila REDIS_URL diisi, "inline" bila tidak.
RULE_ENGINE_MODE=
RULE_ENGINE_TICK=1
# Penjadwalan (tahap 14): jadwal yang terlambat lebih dari N detik dicatat "Skipped".
RULE_SCHEDULE_GRACE_SECONDS=300
# Housekeeping (tahap 16): device dianggap offline setelah N detik tanpa data;
# ringkasan telemetri per menit dihitung ulang mundur N detik (data terlambat).
DEVICE_OFFLINE_SECONDS=300
TELEMETRY_ROLLUP_LATE_SECONDS=600
# Telegram (tahap 17): token bot dari @BotFather. Rahasia, jangan di-commit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Log aktivitas (tahap 18): hapus baris lebih tua dari N hari (0 = simpan selamanya).
ACTIVITY_LOG_DAYS=180
# Email untuk aksi "Send email", aktivasi akun, dan lupa password.
# EMAIL_HOST kosong = email dicetak di terminal (salin tautan aktivasi/reset dari sana).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=IoT Platform <iot@localhost>
# Lama berlaku tautan di email (aktivasi, ganti email, reset password), dalam jam.
DJANGO_EMAIL_LINK_HOURS=24

# Pembaruan firmware OTA (tahap 9). Alamat server yang dipakai DEVICE untuk mengunduh
# firmware, mis. http://192.168.1.10:8000 (IP komputer ini di Wi-Fi). Kosong = alamat di
# address bar browser, yang tidak bisa dijangkau ESP32 bila berupa 127.0.0.1.
# Jangan lupa menambahkan IP itu ke DJANGO_ALLOWED_HOSTS dan menjalankan `runall 0.0.0.0:8000`.
OTA_BASE_URL=

# Login untuk aplikasi lain (tahap 22). Buat kunci sekali: python manage.py oidc_key
# OIDC_ISSUER kosong = dihitung dari alamat request (cukup di laptop).
OIDC_ISSUER=
OIDC_RSA_PRIVATE_KEY_FILE=
OTA_MAX_FIRMWARE_SIZE=4194304
OTA_COMMAND_TTL=600
OTA_DOWNLOAD_TTL=1800
OTA_UPDATE_TIMEOUT=900
