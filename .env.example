# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File .env TIDAK boleh ikut di-commit ke git (sudah ada di .gitignore).

DJANGO_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=iot_platform
DB_USER=iot_user
DB_PASSWORD=ganti_password
DB_HOST=127.0.0.1
DB_PORT=3306

# MQTT broker. Bawaan: broker publik EMQX (tanpa login, bisa dibaca siapa saja).
# Ganti nilai-nilai ini untuk memakai broker lain, mis. Mosquitto di server sendiri.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=False
# Awal semua topik; di broker publik buat UNIK, mis. filkom-iot-7f3a9c
MQTT_TOPIC_PREFIX=ganti-dengan-prefix-unik
MQTT_CLIENT_ID=
MQTT_KEEPALIVE=60

# WebSocket lintas proses (Django Channels + Redis). Kosongkan bila belum ada Redis:
# dashboard tetap real-time untuk data HTTP, dan data MQTT tampil paling lambat 30 detik.
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0

# CoAP (UDP). Device harus bisa menjangkau komputer ini secara langsung.
# COAP_BIND kosong = otomatis (127.0.0.1 + IP Wi-Fi di macOS; semua alamat di Linux)
COAP_BIND=
COAP_PORT=5683
# Alamat yang dipakai device, mis. IP komputer ini di Wi-Fi: 192.168.1.10
COAP_PUBLIC_HOST=
COAP_OBSERVE_INTERVAL=1

# Rule engine (tahap 7). Kosong = otomatis: "worker" bila REDIS_URL diisi, "inline" bila tidak.
RULE_ENGINE_MODE=
RULE_ENGINE_TICK=1
# Email untuk aksi "Send email". EMAIL_HOST kosong = email dicetak di terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=IoT Platform <iot@localhost>
