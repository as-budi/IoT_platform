# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File .env TIDAK boleh ikut di-commit ke git (sudah ada di .gitignore).

DJANGO_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=iot_platform
DB_USER=iot_user
DB_PASSWORD=ganti_password
DB_HOST=127.0.0.1
DB_PORT=3306

# MQTT broker. Bawaan: broker publik EMQX (tanpa login, bisa dibaca siapa saja).
# Ganti nilai-nilai ini untuk memakai broker lain, mis. Mosquitto di server sendiri.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=False
# Awal semua topik; di broker publik buat UNIK, mis. filkom-iot-7f3a9c
MQTT_TOPIC_PREFIX=ganti-dengan-prefix-unik
MQTT_CLIENT_ID=
MQTT_KEEPALIVE=60
