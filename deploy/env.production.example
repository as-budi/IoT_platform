# Contoh .env untuk SERVER PRODUKSI (salin ke /srv/iot/app/.env, lalu: chmod 600 .env).
# Buat nilai acak dengan:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=GANTI-dengan-50-karakter-acak
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=iot.contoh.my.id
DJANGO_CSRF_TRUSTED_ORIGINS=https://iot.contoh.my.id
# Ubah ke True SETELAH sertifikat HTTPS terpasang (langkah 8 panduan).
DJANGO_HTTPS=False
DJANGO_HSTS_SECONDS=3600
# Pendaftaran mandiri ditutup: akun dibuat Admin di menu Users.
DJANGO_ALLOW_SIGNUP=False

DB_NAME=iot_platform
DB_USER=iot_user
DB_PASSWORD=GANTI-password-database-acak
# localhost = lewat Unix socket MySQL (tanpa jaringan sama sekali)
DB_HOST=localhost
DB_PORT=3306

# Broker Mosquitto di server ini. mqtt_bridge tersambung lewat localhost tanpa TLS
# (port 1883 hanya terbuka untuk 127.0.0.1); device memakai port 8883 (TLS).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=iot-bridge
MQTT_PASSWORD=GANTI-password-broker-acak
MQTT_TLS=False
MQTT_TOPIC_PREFIX=iot
MQTT_CLIENT_ID=iot-platform-bridge
MQTT_KEEPALIVE=60
# Pesan desired state: changes = hanya aktuator yang diubah (semua dikirim saat device baru online); all = selalu semua.
MQTT_DESIRED_MESSAGE=changes
# Versi MQTT mqtt_bridge: 5 (bawaan; command diberi batas umur pesan) atau 3.1.1 untuk broker lama.
MQTT_PROTOCOL=5
# Alamat yang ditulis di halaman device (tab MQTT) untuk dipakai DEVICE.
MQTT_PUBLIC_HOST=iot.contoh.my.id
MQTT_PUBLIC_PORT=8883
MQTT_PUBLIC_TLS=True
# Device login dengan username = password = access token (mqtt_accounts).
MQTT_DEVICE_LOGIN=True
# Broker untuk browser dan aplikasi MQTT client web (tahap 21): Nginx -> Mosquitto :9001.
MQTT_PUBLIC_WS_URL=wss://iot.contoh.my.id/mqtt
# Akun MQTT sandbox per pengguna (tahap 23): kosong = ikut MQTT_DEVICE_LOGIN (di sini True).
MQTT_SANDBOX_ENABLED=

# Micro rule / "Run on devices" (tahap 26), masih preview karena firmware belum siap:
#   all = semua pengguna, admin = hanya Admin (untuk mencoba di server), off = tidak tampil.
# Kosong = off (karena DJANGO_DEBUG=False).
MICRO_RULES=admin

REDIS_URL=redis://127.0.0.1:6379/0
RULE_ENGINE_MODE=worker
RULE_ENGINE_TICK=1
# Penjadwalan (tahap 14): jadwal yang terlambat lebih dari N detik dicatat "Skipped".
RULE_SCHEDULE_GRACE_SECONDS=300
# Housekeeping (tahap 16): device dianggap offline setelah N detik tanpa data;
# ringkasan telemetri per menit dihitung ulang mundur N detik (data terlambat).
DEVICE_OFFLINE_SECONDS=300
# Device dengan sesi MQTT terbuka dianggap offline setelah sekian detik tanpa pesan MQTT apa pun
# (Last Will tidak datang). 0 = hanya Last Will.
DEVICE_MQTT_SILENT_SECONDS=900
# Chart halaman variabel: average = rata-rata per interval (ringkasan/rollup), raw = semua bacaan asli.
# Pengguna tetap bisa memilih sendiri di atas chart. CHART_RAW_MAX_POINTS: batas bacaan apa adanya.
CHART_DATA_MODE=average
CHART_RAW_MAX_POINTS=20000
TELEMETRY_ROLLUP_LATE_SECONDS=600
# Telegram (tahap 17): token bot dari @BotFather. Rahasia, jangan di-commit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Log aktivitas (tahap 18): hapus baris lebih tua dari N hari (0 = simpan selamanya).
ACTIVITY_LOG_DAYS=180

# CoAP (UDP) tanpa enkripsi. Biarkan port 5683 TERTUTUP di firewall kecuali
# memang dipakai (lihat bagian keamanan panduan).
COAP_BIND=
COAP_PORT=5683
COAP_PUBLIC_HOST=iot.contoh.my.id

OTA_BASE_URL=https://iot.contoh.my.id
# Kamera / snapshot ESP32-CAM (tahap 27a). Gambar disimpan di CAMERA_STORAGE_DIR (bawaan private_media/camera).
CAMERA_MAX_SNAPSHOT_KB=512
CAMERA_MIN_INTERVAL_S=2
CAMERA_RETENTION_DAYS=30
# Kuota gambar per pemilik device (MB); bila penuh, gambar tertua dihapus. 0 = tanpa batas.
CAMERA_STORAGE_QUOTA_MB=1024
# Produksi dengan nginx (location internal /protected/camera/); kosong = Django mengirim file sendiri.
CAMERA_X_ACCEL_PREFIX=/protected/camera/

# Login untuk aplikasi lain, mis. MQTT client web (tahap 22). Issuer = alamat dasar
# OpenID Connect, persis dengan yang dikenal aplikasi klien. Kunci RSA dibuat dengan
# `manage.py oidc_key` (bawaan private_media/oidc/private.pem, ikut backup).
OIDC_ISSUER=https://iot.contoh.my.id/o
# OIDC_RSA_PRIVATE_KEY_FILE=
# OAUTH_ACCESS_TOKEN_SECONDS=600
# OAUTH_REFRESH_TOKEN_DAYS=14

# Email: aksi aturan, aktivasi akun (Sign up), konfirmasi email baru, lupa password.
# Kosong = tidak dikirim, hanya dicatat di journal. Lihat langkah 10.1 di panduan.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=IoT Platform <iot@contoh.my.id>
DJANGO_EMAIL_LINK_HOURS=24

# Gaya tampilan: standard (bawaan) atau filkom (navy-oranye FILKOM UB, bilah atas dan kaki halaman
# Robotic and Embedded System Laboratory). Berlaku untuk pengunjung dan akun yang belum memilih.
UI_STYLE=standard
# True = setiap akun boleh memilih Standard / FILKOM di side menu; False = semua memakai UI_STYLE.
UI_STYLE_SELECTABLE=True
