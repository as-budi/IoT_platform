# Web (halaman, API HTTP, WebSocket): Daphne di 127.0.0.1:8001, di belakang Nginx.
[Unit]
Description=IoT platform web (Daphne)
After=network-online.target mysql.service redis-server.service
Wants=network-online.target
PartOf=iot.target

[Service]
User=iot
Group=iot
WorkingDirectory=/srv/iot/app
# --proxy-headers: percayai X-Forwarded-For/Proto dari Nginx (IP asli & https).
ExecStart=/srv/iot/venv/bin/daphne --proxy-headers -b 127.0.0.1 -p 8001 config.asgi:application
Restart=always
RestartSec=3
# Satu-satunya folder yang boleh ditulis: file firmware yang diunggah.
ReadWritePaths=/srv/iot/app/private_media
# --- Pengamanan proses (systemd sandboxing) ---
# Proses tidak bisa menjadi root lagi, tidak bisa menulis ke sistem berkas
# kecuali folder yang disebut, dan tidak melihat /home maupun /tmp bersama.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=iot.target
