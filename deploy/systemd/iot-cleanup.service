# Menghapus akun Sign up yang tidak pernah diaktivasi (manage.py delete_unactivated).
# Dijalankan iot-cleanup.timer setiap hari. Sejak fase 4 rencana container, perintahnya berjalan
# di container sementara (service "manage" di compose.yml), jadi unit ini berjalan sebagai root
# (pemakai docker); container sendiri tetap berjalan sebagai user iot, read-only.
# Cara lama: git show 1e08b09:deploy/systemd/iot-cleanup.service
[Unit]
Description=IoT platform: delete sign-ups never activated
After=docker.service mysql.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/iot/app
ExecStart=/bin/sh -c 'APP_UID=$$(id -u iot) APP_GID=$$(id -g iot) exec docker compose -f /srv/iot/app/compose.yml run --rm -T manage python manage.py delete_unactivated --days 7'
