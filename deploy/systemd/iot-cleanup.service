# Menghapus akun Sign up yang tidak pernah diaktivasi (manage.py delete_unactivated).
# Dijalankan iot-cleanup.timer setiap hari.
[Unit]
Description=IoT platform: delete sign-ups never activated
After=mysql.service

[Service]
Type=oneshot
User=iot
Group=iot
WorkingDirectory=/srv/iot/app
ExecStart=/srv/iot/venv/bin/python manage.py delete_unactivated --days 7
# --- Pengamanan proses (systemd sandboxing) ---
# Proses tidak bisa menjadi root lagi, tidak bisa menulis ke sistem berkas
# kecuali folder yang disebut, dan tidak melihat /home maupun /tmp bersama.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
