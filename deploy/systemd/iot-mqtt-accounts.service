# Menyusun akun Mosquitto dari daftar device (manage.py mqtt_accounts).
# Dijalankan iot-mqtt-accounts.timer setiap 2 menit. Sejak fase 4 rencana container, perintahnya
# berjalan di container sementara (service "manage" di compose.yml, yang memasang /srv/iot/mosquitto
# dan membawa mosquitto_passwd). File yang ditulis sama dengan sebelumnya, jadi iot-mqtt-reload.path
# dan iot-mqtt-reload.service (root, menyalin ke /etc/mosquitto/iot) TIDAK berubah.
# Cara lama: git show 1e08b09:deploy/systemd/iot-mqtt-accounts.service
[Unit]
Description=IoT platform: sync Mosquitto accounts from devices
After=docker.service mysql.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/iot/app
ExecStart=/bin/sh -c 'APP_UID=$$(id -u iot) APP_GID=$$(id -g iot) exec docker compose -f /srv/iot/app/compose.yml run --rm -T manage python manage.py mqtt_accounts --passwd-file /srv/iot/mosquitto/passwd --acl-file /srv/iot/mosquitto/acl'
